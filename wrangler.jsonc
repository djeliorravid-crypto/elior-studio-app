// Cloudflare Worker config — lets Workers Builds deploy
// whatsapp-worker.js straight from this repo on every push to main.
// One-time setup: dash.cloudflare.com → ravid-whatsapp → Settings →
// Builds → Connect repository (this repo, branch main). After that,
// no more copy-pasting code into the dashboard editor — ever.
//
// Secrets (WHATSAPP_TOKEN, SEND_SECRET, GEMINI_KEY, APNS_*) live in
// the dashboard and survive deploys. The cron trigger below is
// applied automatically on each deploy.
{
  "name": "ravid-whatsapp",
  "main": "whatsapp-worker.js",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "triggers": {
    // Every minute: due scheduled messages go out on the minute;
    // the hourly "X מחכים לתשובה" push fires only at minute 0.
    "crons": ["* * * * *"]
  }
}
