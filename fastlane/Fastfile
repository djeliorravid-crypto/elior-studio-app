default_platform(:ios)

require "spaceship"

APP_IDENTIFIER = "com.ravidstudio.app"
APP_NAME       = "Ravid Studio"
XCODE_PROJECT  = "ios/App/App.xcodeproj"
SCHEME         = "App"

platform :ios do
  desc "Build the iOS app and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath:  ENV["API_KEY_PATH"],
      duration:      1200,
      in_house:      false,
    )

    # Each fresh CI run creates a new Distribution certificate; the
    # private key from prior runs lives in their (now-destroyed)
    # keychains, so old certs are useless and just eat into Apple's
    # 2-3 per-team Distribution cert cap. Revoke every existing one
    # before creating a new one for this run.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      filepath:  ENV["API_KEY_PATH"],
    )
    existing_certs = Spaceship::ConnectAPI::Certificate.all
    existing_certs.each do |c|
      next unless %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type)
      UI.message("Revoking orphaned Distribution certificate #{c.id} (#{c.name})")
      c.delete!
    end

    build_number = (ENV["GITHUB_RUN_NUMBER"] || "0").to_i + 1000
    increment_build_number(
      build_number: build_number,
      xcodeproj:    XCODE_PROJECT,
    )

    cert(
      development:    false,
      api_key:        api_key,
      output_path:    "./fastlane/certificates",
      generate_apple_certs: true,
    )

    sigh(
      app_identifier: APP_IDENTIFIER,
      api_key:        api_key,
      force:          true,
      output_path:    "./fastlane/profiles",
    )

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] ||
                   lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  XCODE_PROJECT,
      team_id:               ENV["APPLE_TEAM_ID"],
      bundle_identifier:     APP_IDENTIFIER,
      code_sign_identity:    "Apple Distribution",
      profile_name:          profile_name,
      targets:               [SCHEME],
      build_configurations:  ["Release"],
    )

    # Expose the profile name so the workflow's raw `xcodebuild`
    # step can reference it via $SIGH_NAME.
    File.write(File.expand_path("../../.sigh_name", __FILE__), profile_name) if profile_name

    # Build + export are run as raw `xcodebuild` in a separate
    # workflow step. fastlane's `build_app` (gym) wraps everything
    # in `xcbeautify`, which buffers output and hides whether the
    # archive is actually progressing — making slow builds
    # indistinguishable from hangs. Raw xcodebuild streams its
    # output directly so each compile / link step is visible live
    # in the CI log.
  end
end
