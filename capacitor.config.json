{
  "appId": "com.ravidstudio.app",
  "appName": "Maestro",
  "webDir": "www",
  "server": {
    "url": "https://djeliorravid-crypto.github.io/elior-studio-app/",
    "iosScheme": "https",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Ravid Studio",
    "backgroundColor": "#f5f7fd"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#f5f7fd",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
