{
  "appId": "com.ravidstudio.app",
  "appName": "Ravid Studio",
  "webDir": ".",
  "server": {
    "iosScheme": "ravidstudio",
    "cleartext": false
  },
  "ios": {
    "contentInset": "automatic",
